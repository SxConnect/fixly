# Fixly - Environment Variables
# Copy this file to .env.local and fill in the values

# Database (Neon)
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/fixly?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/fixly?sslmode=require"

# Auth (JWT)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# AI (OpenRouter)
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_PRIMARY_MODEL="anthropic/claude-3.5-sonnet"
AI_FALLBACK_MODEL="openai/gpt-4o-mini"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Fixly <noreply@yourdomain.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="Fixly"

# Feature Flags
ENABLE_INSTAGRAM="false"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Generation Limits (weekly)
WEEKLY_PRODUCT_LIMIT="10"
WEEKLY_IDEAS_LIMIT="100"
WEEKLY_ADJUSTMENTS_LIMIT="50"

# Review Threshold
CHAPTER_REVIEW_THRESHOLD="7"
MAX_REGENERATION_ATTEMPTS="2"

# Download Links
DOWNLOAD_LINK_MAX_USES="30"
DOWNLOAD_LINK_EXPIRY_HOURS="720"

# Webhook Secrets
KIWIFY_WEBHOOK_SECRET="your-kiwify-secret"
HOTMART_WEBHOOK_SECRET="your-hotmart-secret"
